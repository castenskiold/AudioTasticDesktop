<Project Sdk="Microsoft.NET.Sdk">
  <!-- PG-02: public plugin contracts, published as the AudioTastic.Sdk NuGet package. Must not reference any other
       AudioTastic project. Pre-release (0.x) until P8: contracts may still change. -->
  <PropertyGroup>
    <Version>0.4.0-preview</Version>
    <PackageId>AudioTastic.Sdk</PackageId>
    <Title>AudioTastic plugin SDK</Title>
    <Description>Contracts for AudioTastic Desktop plugins: input (decoders), output, DSP, visualisation, general, UI panel and cast target plugins.</Description>
    <PackageTags>audiotastic;audio;player;plugin;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- MIT, so anyone can write free or commercial plugins (Anders, 17 Nov 2026). The player app's licence is separate. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every public member is documented in source; the package carries the XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
