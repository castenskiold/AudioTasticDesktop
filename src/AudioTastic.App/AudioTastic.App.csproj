<Project Sdk="Microsoft.NET.Sdk">
  <!-- CO-01: Avalonia desktop application (the player itself). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AudioTastic</AssemblyName>
    <RootNamespace>AudioTastic.App</RootNamespace>
    <ApplicationIcon>$(RepoRoot)assets\branding\audiotastic.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Self-contained publish for every supported runtime identifier: dotnet publish -r <rid> -c Release -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Avalonia views must be public for the XAML loader; CA1515 does not apply to them. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioTastic.Core\AudioTastic.Core.csproj" />
    <ProjectReference Include="..\AudioTastic.Data\AudioTastic.Data.csproj" />
    <ProjectReference Include="..\AudioTastic.Platform\AudioTastic.Platform.csproj" />
    <ProjectReference Include="..\AudioTastic.Platform.Windows\AudioTastic.Platform.Windows.csproj" />
    <ProjectReference Include="..\AudioTastic.Platform.MacOS\AudioTastic.Platform.MacOS.csproj" />
    <ProjectReference Include="..\AudioTastic.Platform.Linux\AudioTastic.Platform.Linux.csproj" />
    <ProjectReference Include="..\AudioTastic.Sdk\AudioTastic.Sdk.csproj" />
    <ProjectReference Include="..\AudioTastic.Plugins.Host\AudioTastic.Plugins.Host.csproj" />
    <ProjectReference Include="..\AudioTastic.Analysis\AudioTastic.Analysis.csproj" />
    <ProjectReference Include="..\AudioTastic.Metadata\AudioTastic.Metadata.csproj" />
    <ProjectReference Include="..\AudioTastic.Casting\AudioTastic.Casting.csproj" />
  </ItemGroup>

  <!-- PG-01: built-in plugins are built but not referenced; they are copied to plugins/<name>/ and loaded by the
       plugin host like third-party plugins (rules in Directory.Build.targets). -->
  <ItemGroup>
    <BuiltInPlugin Include="..\..\plugins\AudioTastic.Input.Ffmpeg\AudioTastic.Input.Ffmpeg.csproj" />
  </ItemGroup>

  <!-- Branding assets live once in /assets/branding and are linked in (UI-04). -->
  <ItemGroup>
    <AvaloniaResource Include="$(RepoRoot)assets\branding\audiotastic-logo-transparent.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="$(RepoRoot)assets\branding\audiotastic.ico" Link="Assets\audiotastic.ico" />
  </ItemGroup>

  <!-- UI-03: skin.json schema (validated at load) and the built-in default skin (UI-02), embedded as
       "AudioTastic.Skins.Default/<path>". Inter (OFL) and the logo are linked from where they already live. -->
  <ItemGroup>
    <EmbeddedResource Include="$(RepoRoot)docs\skins\skin.schema.json" LogicalName="AudioTastic.Skins.skin.schema.json" />
    <EmbeddedResource Include="Skins\Default\**\*" LogicalName="AudioTastic.Skins.Default/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(RepoRoot)docs\pdf-src\fonts\Inter-Light.ttf;$(RepoRoot)docs\pdf-src\fonts\Inter-Regular.ttf;$(RepoRoot)docs\pdf-src\fonts\Inter-Medium.ttf;$(RepoRoot)docs\pdf-src\fonts\Inter-SemiBold.ttf;$(RepoRoot)docs\pdf-src\fonts\Inter-Bold.ttf;$(RepoRoot)docs\pdf-src\fonts\LICENSE-Inter.txt"
                      LogicalName="AudioTastic.Skins.Default/fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(RepoRoot)assets\branding\png\audiotastic-32.png" LogicalName="AudioTastic.Skins.Default/images/logo.png" />
    <EmbeddedResource Include="$(RepoRoot)assets\branding\png\audiotastic-64.png" LogicalName="AudioTastic.Skins.Default/images/logo@2x.png" />
    <!-- UI-04: About dialog lists the third-party notices. -->
    <EmbeddedResource Include="$(RepoRoot)THIRD-PARTY-NOTICES.md" LogicalName="AudioTastic.ThirdPartyNotices.md" />
  </ItemGroup>

  <!-- Native libraries (FFmpeg, miniaudio, ...) are copied by Directory.Build.targets. -->
  <PropertyGroup>
    <CopyNativeLibraries>true</CopyNativeLibraries>
  </PropertyGroup>
</Project>
