{
  "$schema": "../../../../docs/skins/skin.schema.json",
  "format": 1,
  "name": "AudioTastic",
  "author": "AudioTastic",
  "version": "1.0.0",
  "description": "The default skin: slim, dark and monochrome, based on the AudioTastic logo (UI-02).",
  "colors": {
    "bg": "#0B0B0C",
    "panel": "#131315",
    "line": "#2A2A2E",
    "dim": "#45454B",
    "muted": "#8E8E93",
    "text": "#F2F2F2"
  },
  "fonts": {
    "title": { "family": "Inter", "files": ["fonts/Inter-SemiBold.ttf"], "weight": "semibold", "size": 6.5 },
    "time": { "family": "Inter", "files": ["fonts/Inter-Light.ttf"], "weight": "light", "size": 22 },
    "body": { "family": "Inter", "files": ["fonts/Inter-Regular.ttf"], "weight": "regular", "size": 8 },
    "medium": { "family": "Inter", "files": ["fonts/Inter-Medium.ttf"], "weight": "medium", "size": 8 },
    "badge": { "family": "Inter", "files": ["fonts/Inter-SemiBold.ttf"], "weight": "semibold", "size": 5.5 },
    "heading": { "family": "Inter", "files": ["fonts/Inter-Bold.ttf"], "weight": "bold", "size": 8.5 },
    "timeSmall": { "family": "Inter", "files": ["fonts/Inter-Light.ttf"], "weight": "light", "size": 8 }
  },
  "windows": {
    "main": {
      "width": 330,
      "height": 134,
      "background": "@panel",
      "border": "@text",
      "borderWidth": 1,
      "cornerRadius": 6,
      "elements": [
        { "type": "dragArea", "x": 0, "y": 0, "width": 330, "height": 18 },
        { "type": "button", "bind": "menu", "x": 4, "y": 3, "width": 12, "height": 12, "image": "images/logo.png", "tooltip": "Main menu" },
        { "type": "text", "x": 20, "y": 3, "width": 150, "height": 12, "text": "AUDIOTASTIC", "font": "title", "color": "@muted", "letterSpacing": 2 },
        { "type": "button", "bind": "miniPlayer", "x": 284, "y": 3, "width": 12, "height": 12, "image": "images/circle.svg",
          "images": { "hover": "images/circle-filled.svg" }, "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Mini player (Ctrl+W)" },
        { "type": "button", "bind": "minimize", "x": 298, "y": 3, "width": 12, "height": 12, "image": "images/circle.svg",
          "images": { "hover": "images/circle-filled.svg" }, "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Minimise" },
        { "type": "button", "bind": "close", "x": 312, "y": 3, "width": 12, "height": 12, "image": "images/circle.svg",
          "images": { "hover": "images/circle-filled.svg" }, "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Close" },

        { "type": "rect", "x": 8, "y": 20, "width": 314, "height": 54, "fill": "@bg", "stroke": "@line", "strokeWidth": 1, "cornerRadius": 5 },
        { "type": "rect", "x": 14, "y": 26, "width": 42, "height": 42, "stroke": "@line", "strokeWidth": 1, "cornerRadius": 4 },
        { "type": "art", "x": 17, "y": 29, "width": 36, "height": 36 },
        { "type": "time", "x": 62, "y": 25, "width": 92, "height": 28, "font": "time", "color": "@text" },
        { "type": "visualisation", "x": 64, "y": 56, "width": 88, "height": 14, "fillColor": "@text", "thumbColor": "@text", "trackColor": "@dim",
          "tooltip": "Click: spectrum, oscilloscope, off" },
        { "type": "marquee", "x": 160, "y": 28, "width": 156, "height": 12, "font": "body", "color": "@text", "speed": 25 },
        { "type": "indicators", "x": 160, "y": 45, "width": 156, "height": 10, "font": "badge", "color": "@text", "stroke": "@dim", "spacing": 3 },
        { "type": "indicators", "bind": "state", "x": 160, "y": 58, "width": 156, "height": 10, "font": "badge", "color": "@text", "stroke": "@dim", "spacing": 3 },

        { "type": "rect", "x": 8, "y": 78, "width": 314, "height": 26, "fill": "@bg", "stroke": "@line", "strokeWidth": 1, "cornerRadius": 4 },
        { "type": "waveform", "x": 12, "y": 80, "width": 306, "height": 22,
          "trackColor": "@dim", "fillColor": "@text", "thumbColor": "@text", "tooltip": "Waveform: click or drag to seek" },

        { "type": "button", "bind": "previous", "x": 10, "y": 111, "width": 16, "height": 13, "image": "images/previous.svg", "padding": 2,
          "cornerRadius": 3, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@text", "pressed": "@bg" }, "tooltip": "Previous (Z)" },
        { "type": "button", "bind": "play", "x": 28, "y": 111, "width": 16, "height": 13, "image": "images/play.svg", "padding": 2,
          "cornerRadius": 3, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@text", "pressed": "@bg" }, "tooltip": "Play (X)" },
        { "type": "button", "bind": "pause", "x": 46, "y": 111, "width": 16, "height": 13, "image": "images/pause.svg", "padding": 2,
          "cornerRadius": 3, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@text", "pressed": "@bg" }, "tooltip": "Pause (C)" },
        { "type": "button", "bind": "stop", "x": 64, "y": 111, "width": 16, "height": 13, "image": "images/stop.svg", "padding": 2,
          "cornerRadius": 3, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@text", "pressed": "@bg" }, "tooltip": "Stop (V)" },
        { "type": "button", "bind": "next", "x": 82, "y": 111, "width": 16, "height": 13, "image": "images/next.svg", "padding": 2,
          "cornerRadius": 3, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@text", "pressed": "@bg" }, "tooltip": "Next (B)" },
        { "type": "button", "bind": "open", "x": 100, "y": 111, "width": 16, "height": 13, "image": "images/open.svg", "padding": 2,
          "cornerRadius": 3, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@text", "pressed": "@bg" }, "tooltip": "Open files (L)" },

        { "type": "slider", "bind": "volume", "x": 122, "y": 111, "width": 56, "height": 13,
          "trackColor": "@dim", "fillColor": "@text", "thumbColor": "@text", "thumbSize": 5, "trackThickness": 1.2, "tooltip": "Volume (Up/Down, wheel)" },

        { "type": "toggle", "bind": "shuffle", "x": 184, "y": 112, "width": 24, "height": 11, "text": "SHUF", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Shuffle (S)" },
        { "type": "toggle", "bind": "repeat", "x": 211, "y": 112, "width": 22, "height": 11, "text": "REP", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Repeat: off / playlist / track (R)" },
        { "type": "toggle", "bind": "crossfade", "x": 236, "y": 112, "width": 17, "height": 11, "text": "XF", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Crossfading" },
        { "type": "toggle", "bind": "equalizer", "x": 256, "y": 112, "width": 17, "height": 11, "text": "EQ", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Equalizer (Alt+G)" },
        { "type": "toggle", "bind": "playlist", "x": 276, "y": 112, "width": 17, "height": 11, "text": "PL", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Playlist (Alt+E)" },
        { "type": "toggle", "bind": "cast", "x": 296, "y": 112, "width": 25, "height": 11, "text": "CAST", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Cast to a device" }
      ]
    },
    "mini": {
      "width": 330,
      "height": 56,
      "background": "@panel",
      "border": "@text",
      "borderWidth": 1,
      "cornerRadius": 10,
      "elements": [
        { "type": "dragArea", "x": 0, "y": 0, "width": 330, "height": 56 },
        { "type": "button", "bind": "menu", "x": 10, "y": 7, "width": 12, "height": 12, "image": "images/logo.png", "tooltip": "Main menu" },
        { "type": "marquee", "x": 28, "y": 6, "width": 270, "height": 14, "font": "heading", "color": "@text", "speed": 25 },
        { "type": "button", "bind": "expand", "x": 308, "y": 7, "width": 12, "height": 12, "image": "images/expand.svg",
          "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Full player (Ctrl+W, or double-click)" },

        { "type": "time", "x": 6, "y": 32, "width": 28, "height": 14, "font": "timeSmall", "color": "@text", "align": "right" },
        { "type": "slider", "bind": "seek", "x": 38, "y": 33, "width": 94, "height": 12,
          "trackColor": "@dim", "fillColor": "@text", "thumbColor": "@text", "thumbSize": 6, "trackThickness": 1.2, "tooltip": "Seek" },
        { "type": "time", "bind": "duration", "x": 136, "y": 32, "width": 28, "height": 14, "font": "timeSmall", "color": "@muted" },

        { "type": "button", "bind": "previous", "x": 166, "y": 33, "width": 12, "height": 12, "image": "images/previous.svg",
          "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Previous (Z)" },
        { "type": "button", "bind": "playPause", "x": 182, "y": 29, "width": 20, "height": 20, "image": "images/play.svg",
          "images": { "active": "images/pause.svg" }, "padding": 4.5, "cornerRadius": 10, "strokeWidth": 1,
          "strokes": { "normal": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@text", "pressed": "@bg" }, "tooltip": "Play / pause (X / C)" },
        { "type": "button", "bind": "stop", "x": 206, "y": 33, "width": 12, "height": 12, "image": "images/stop.svg",
          "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Stop (V)" },
        { "type": "button", "bind": "next", "x": 222, "y": 33, "width": 12, "height": 12, "image": "images/next.svg",
          "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Next (B)" },

        { "type": "toggle", "bind": "shuffle", "x": 242, "y": 34, "width": 22, "height": 10, "text": "SHF", "font": "badge",
          "cornerRadius": 5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Shuffle (S)" },
        { "type": "toggle", "bind": "playlist", "x": 267, "y": 34, "width": 17, "height": 10, "text": "PL", "font": "badge",
          "cornerRadius": 5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Playlist (Alt+E)" },
        { "type": "toggle", "bind": "mute", "x": 292, "y": 32, "width": 14, "height": 14, "image": "images/speaker.svg",
          "images": { "active": "images/speaker-muted.svg" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@muted" },
          "tooltip": "Mute (mouse wheel: volume)" }
      ]
    },
    "playlist": {
      "width": 330,
      "height": 232,
      "resizable": true,
      "minWidth": 275,
      "minHeight": 116,
      "background": "@panel",
      "border": "@text",
      "borderWidth": 1,
      "cornerRadius": 6,
      "elements": [
        { "type": "dragArea", "x": 0, "y": 0, "width": 330, "height": 18, "anchor": "left right top" },
        { "type": "text", "x": 10, "y": 3, "width": 150, "height": 12, "text": "PLAYLIST", "font": "title", "color": "@muted", "letterSpacing": 2 },
        { "type": "button", "bind": "hide", "x": 312, "y": 3, "width": 12, "height": 12, "anchor": "right top", "image": "images/circle.svg",
          "images": { "hover": "images/circle-filled.svg" }, "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Close playlist (Alt+E)" },

        { "type": "playlistTabs", "x": 8, "y": 20, "width": 314, "height": 11, "anchor": "left right top", "font": "badge", "spacing": 3,
          "strokeWidth": 0.8, "strokes": { "normal": "@dim", "active": "@text" }, "fills": { "active": "@text" },
          "colors": { "normal": "@muted", "active": "@bg" } },
        { "type": "playlistSearch", "x": 8, "y": 34, "width": 314, "height": 12, "anchor": "left right top", "font": "body", "fontSize": 7.4,
          "stroke": "@line", "strokeWidth": 0.8, "color": "@text", "text": "J   Search playlist…" },

        { "type": "rect", "x": 6, "y": 49, "width": 318, "height": 163, "anchor": "left right top bottom",
          "fill": "@bg", "stroke": "@line", "strokeWidth": 1, "cornerRadius": 4 },
        { "type": "playlistList", "x": 8, "y": 51, "width": 314, "height": 159, "anchor": "left right top bottom",
          "font": "body", "fontSize": 8.4, "rowHeight": 16, "color": "#C4C4C9", "mutedColor": "@muted",
          "playingColor": "#FFFFFF", "selectionColor": "#2C2C31" },

        { "type": "button", "bind": "plAdd", "x": 8, "y": 216, "width": 21, "height": 11, "anchor": "left bottom", "text": "ADD", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@muted", "hover": "@text", "pressed": "@bg" }, "tooltip": "Add files, folder" },
        { "type": "button", "bind": "plRemove", "x": 32, "y": 216, "width": 21, "height": 11, "anchor": "left bottom", "text": "REM", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@muted", "hover": "@text", "pressed": "@bg" }, "tooltip": "Remove selected, duplicates, dead entries" },
        { "type": "button", "bind": "plSelect", "x": 56, "y": 216, "width": 19, "height": 11, "anchor": "left bottom", "text": "SEL", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@muted", "hover": "@text", "pressed": "@bg" }, "tooltip": "Select all / none / invert" },
        { "type": "button", "bind": "plSort", "x": 78, "y": 216, "width": 23, "height": 11, "anchor": "left bottom", "text": "SORT", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@muted", "hover": "@text", "pressed": "@bg" }, "tooltip": "Sort, reverse, randomise, undo" },
        { "type": "button", "bind": "plList", "x": 104, "y": 216, "width": 21, "height": 11, "anchor": "left bottom", "text": "LIST", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@muted", "hover": "@text", "pressed": "@bg" }, "tooltip": "New, load, save playlists" },

        { "type": "playlistInfo", "x": 150, "y": 216, "width": 156, "height": 11, "anchor": "right bottom", "font": "medium", "fontSize": 7.4,
          "color": "@muted", "align": "right" },
        { "type": "resizeGrip", "x": 314, "y": 216, "width": 16, "height": 16, "anchor": "right bottom" }
      ]
    },
    "equalizer": {
      "width": 330,
      "height": 116,
      "background": "@panel",
      "border": "@text",
      "borderWidth": 1,
      "cornerRadius": 6,
      "elements": [
        { "type": "dragArea", "x": 0, "y": 0, "width": 330, "height": 18 },
        { "type": "text", "x": 10, "y": 3, "width": 150, "height": 12, "text": "EQUALIZER", "font": "title", "color": "@muted", "letterSpacing": 2 },
        { "type": "button", "bind": "hide", "x": 312, "y": 3, "width": 12, "height": 12, "image": "images/circle.svg",
          "images": { "hover": "images/circle-filled.svg" }, "colors": { "normal": "@muted", "hover": "@text" }, "tooltip": "Close equalizer (Alt+G)" },

        { "type": "toggle", "bind": "eqOn", "x": 8, "y": 21, "width": 17, "height": 11, "text": "ON", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Equalizer on/off" },
        { "type": "toggle", "bind": "eqAuto", "x": 28, "y": 21, "width": 25, "height": 11, "text": "AUTO", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Auto EQ: load the preset assigned to the file or genre" },
        { "type": "toggle", "bind": "eqParam", "x": 56, "y": 21, "width": 29, "height": 11, "text": "PARAM", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@muted", "active": "@text", "disabled": "@line" },
          "fills": { "active": "@text" }, "colors": { "normal": "@muted", "hover": "@text", "active": "@bg", "disabled": "@dim" }, "tooltip": "Parametric editor" },
        { "type": "button", "bind": "eqPresets", "x": 88, "y": 21, "width": 35, "height": 11, "text": "PRESETS", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@muted", "hover": "@text", "pressed": "@bg" }, "tooltip": "Load, save, import and assign presets" },
        { "type": "button", "bind": "eqDsp", "x": 126, "y": 21, "width": 20, "height": 11, "text": "DSP", "font": "badge",
          "cornerRadius": 5.5, "strokeWidth": 0.8, "strokes": { "normal": "@dim", "hover": "@text" }, "fills": { "pressed": "@text" },
          "colors": { "normal": "@muted", "hover": "@text", "pressed": "@bg" }, "tooltip": "DSP chain: compressor, limiter, reverb, widening" },

        { "type": "rect", "x": 152, "y": 20, "width": 170, "height": 14, "fill": "@bg", "stroke": "@line", "strokeWidth": 1, "cornerRadius": 3 },
        { "type": "eqCurve", "x": 155, "y": 21, "width": 164, "height": 12, "trackColor": "@line", "fillColor": "@text", "color": "@muted", "font": "badge", "fontSize": 4.5 },

        { "type": "rect", "x": 8, "y": 37, "width": 314, "height": 73, "fill": "@bg", "stroke": "@line", "strokeWidth": 1, "cornerRadius": 4 },
        { "type": "eqSlider", "bind": "preamp", "x": 14, "y": 41, "width": 12, "height": 56, "trackColor": "@dim", "fillColor": "@text", "thumbColor": "@text", "thumbSize": 5 },
        { "type": "text", "x": 8, "y": 99, "width": 24, "height": 9, "text": "PRE", "font": "badge", "color": "@muted", "align": "center" },
        { "type": "text", "x": 30, "y": 40, "width": 18, "height": 7, "text": "+12", "font": "badge", "fontSize": 4.5, "color": "@dim", "align": "right" },
        { "type": "text", "x": 30, "y": 65.5, "width": 18, "height": 7, "text": "0", "font": "badge", "fontSize": 4.5, "color": "@dim", "align": "right" },
        { "type": "text", "x": 30, "y": 91, "width": 18, "height": 7, "text": "-12", "font": "badge", "fontSize": 4.5, "color": "@dim", "align": "right" },
        { "type": "eqSlider", "bind": "band0", "x": 52, "y": 41, "width": 12, "height": 56, "trackColor": "@dim", "fillColor": "@text", "thumbColor": "@text", "thumbSize": 5 },
        { "type": "text", "x": 46, "y": 99, "width": 24, "height": 9, "text": "60", "font": "badge", "color": "@muted", "align": "center" },
        { "type": "eqSlider", "bind": "band1", "x": 79, "y": 41, "width": 12, "height": 56, "trackColor": "@dim", "fillColor": "@text", "thumbColor": "@text", "thumbSize": 5 },
        { "type": "text", "x": 73, "y": 99, "width": 24, "height": 9, "text": "170", "font": "badge", "color": "@muted", "align": "center" },
        { "type": "eqSlider", "bind": "band2", "x": 106, "y": 41, "width": 12, "height": 56, "trackColor": "@dim", "fillColor": "@text", "thumbColor": "@text", "thumbSize": 5 },
        { "type": "text", "x": 100, "y": 99, "width": 24, "height": 9, "text": "310", "font": "badge", "color": "@muted", "align": "center" },
        { "type": "eqSlider", "bind": "band3", "x": 133, "y": 41, "width": 12, "height": 56, "trackColor": "@dim", "fillColor": "@text", "thumbColor": "@text", "thumbSize": 5 },
