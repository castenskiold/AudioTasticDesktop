<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AudioTastic.App.MainWindow"
        Title="AudioTastic"
        Icon="/Assets/audiotastic.ico"
        Width="330" Height="128"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="#131315">
  <!-- CO-01 / P0: empty borderless main window (MW1 title bar only). The real player UI comes in P1-P2. -->
  <Border BorderBrush="#F2F2F2" BorderThickness="1">
    <Grid RowDefinitions="18,*">
      <Grid x:Name="TitleBar" ColumnDefinitions="Auto,*,Auto,Auto" Background="#131315"
            PointerPressed="TitleBar_OnPointerPressed">
        <Image Source="/Assets/logo.png" Width="11" Height="11" Margin="5,0,5,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="A U D I O T A S T I C" FontSize="7" FontWeight="SemiBold"
                   Foreground="#8E8E93" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="titleButton" Click="Minimise_OnClick"
                ToolTip.Tip="Minimise" AutomationProperties.Name="Minimise">
          <Ellipse />
        </Button>
        <Button Grid.Column="3" Classes="titleButton" Margin="1,0,5,0" Click="Close_OnClick"
                ToolTip.Tip="Close" AutomationProperties.Name="Close">
          <Ellipse />
        </Button>
      </Grid>
      <Border Grid.Row="1" Margin="8,2,8,8" CornerRadius="5" Background="#0B0B0C"
              BorderBrush="#2A2A2E" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Margin="12,0" Spacing="4">
          <TextBlock Text="AudioTastic" FontSize="16" FontWeight="Light" Foreground="#F2F2F2" />
          <TextBlock x:Name="StatusText" FontSize="9" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
