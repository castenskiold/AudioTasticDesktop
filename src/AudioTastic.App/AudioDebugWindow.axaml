<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AudioTastic.App.AudioDebugWindow"
        Title="AudioTastic – audio debug (P1)"
        Icon="/Assets/audiotastic.ico"
        Width="560" Height="460" MinWidth="460" MinHeight="380"
        DragDrop.AllowDrop="True">
  <!-- P1 temporary test window (Implementation Plan, P1 tasks). Replaced by the skinned main window in P2. -->
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="OpenButton" Content="Open…" Click="Open_OnClick" ToolTip.Tip="Open files (L)" AutomationProperties.Name="Open files" />
        <Button Content="⏮" Click="Previous_OnClick" ToolTip.Tip="Previous (Z)" AutomationProperties.Name="Previous" />
        <Button Content="▶" Click="Play_OnClick" ToolTip.Tip="Play (X)" AutomationProperties.Name="Play" />
        <Button Content="⏸" Click="Pause_OnClick" ToolTip.Tip="Pause (C)" AutomationProperties.Name="Pause" />
        <Button Content="⏹" Click="Stop_OnClick" ToolTip.Tip="Stop (V)" AutomationProperties.Name="Stop" />
        <Button Content="⏭" Click="Next_OnClick" ToolTip.Tip="Next (B)" AutomationProperties.Name="Next" />
      </StackPanel>

      <TextBlock x:Name="TitleText" FontSize="16" Text="Nothing loaded" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="FormatText" Foreground="Gray" Text=" " />

      <Grid ColumnDefinitions="*,Auto">
        <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" IsEnabled="False" AutomationProperties.Name="Seek" />
        <Button Grid.Column="1" x:Name="TimeButton" Margin="8,0,0,0" MinWidth="110" Click="Time_OnClick"
                ToolTip.Tip="Click: elapsed / remaining" AutomationProperties.Name="Time display" Content="0:00 / 0:00" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" AutomationProperties.Name="Volume" />
        <TextBlock Grid.Column="2" x:Name="VolumeText" VerticalAlignment="Center" MinWidth="36" Margin="8,0" />
        <CheckBox Grid.Column="3" x:Name="MuteBox" Content="Mute" AutomationProperties.Name="Mute" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Output" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" x:Name="DeviceBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Output device" />
      </Grid>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap" />
    <ListBox x:Name="TrackList" Margin="0,10,0,0" DoubleTapped="TrackList_OnDoubleTapped" AutomationProperties.Name="Tracks" />
  </DockPanel>
</Window>
