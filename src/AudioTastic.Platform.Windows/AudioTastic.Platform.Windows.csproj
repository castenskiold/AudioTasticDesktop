<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows implementation of AudioTastic.Platform. -->
  <PropertyGroup Condition="'$(IsWindowsBuild)' == 'true'">
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsSupportedVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- LibraryImport (user32) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AudioTastic.Platform\AudioTastic.Platform.csproj" />
  </ItemGroup>
</Project>
