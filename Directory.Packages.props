<Project>
  <!-- Central package versions. Every package must meet the licence policy (CLAUDE.md section 5)
       and be listed in THIRD-PARTY-NOTICES.md. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
    <MicrosoftExtensionsVersion>10.0.15</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI (MIT) -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <!-- Skins (UI-03): SVG rendering (MIT) and skin.json schema validation (MIT; not JsonSchema.Net, whose binaries carry a maintenance-fee EULA) -->
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <PackageVersion Include="NJsonSchema" Version="11.6.2" />
    <!-- SI-08: command-line parser (MIT, .NET Foundation); 2.0.x is the .NET 10 line. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <!-- Hosting and logging abstractions (MIT) -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <!-- Development tools only (tools/AudioTastic.SoakTest) -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
    <!-- Data (MIT; bundles SQLite, public domain, via SQLitePCLRaw, Apache-2.0) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(MicrosoftExtensionsVersion)" />
    <!-- FFmpeg bindings (MIT); the FFmpeg libraries themselves are LGPL, dynamically loaded (FM-01). Keep the major in step with native/fetch_ffmpeg.py. -->
    <PackageVersion Include="FFmpeg.AutoGen" Version="8.1.0" />
    <!-- FM-08 MIDI synthesizer (MIT, pure C#). -->
    <PackageVersion Include="MeltySynth" Version="2.4.1" />
    <!-- Tags (MD-01): LGPL-2.1, used as a separate, replaceable DLL as the licence policy allows -->
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <!-- Logging (Apache-2.0) -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <!-- Tests only (Apache-2.0). xunit v3 runs on Microsoft.Testing.Platform (global.json "test.runner"). -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
  </ItemGroup>
</Project>
