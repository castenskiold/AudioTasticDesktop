[Desktop Entry]
Type=Application
Name=AudioTastic
GenericName=Audio Player
Comment=Winamp-style audio player with DJ-style crossfading
Exec=AudioTastic %F
Icon=audiotastic
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/x-wav;audio/wav;audio/x-aiff;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/mp4;audio/aac;audio/x-m4a;audio/x-ape;audio/x-wavpack;audio/x-musepack;audio/x-ms-wma;audio/x-tta;audio/x-shorten;audio/x-dsf;audio/x-dff;audio/midi;audio/x-mod;audio/x-xm;audio/x-it;audio/x-s3m;audio/x-mpegurl;audio/mpegurl;audio/x-scpls;application/xspf+xml;application/x-cue;
Actions=Enqueue;

[Desktop Action Enqueue]
Name=Enqueue in AudioTastic
Exec=AudioTastic --enqueue %F
