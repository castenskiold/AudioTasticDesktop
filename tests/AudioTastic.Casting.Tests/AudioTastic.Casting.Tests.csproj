<Project Sdk="Microsoft.NET.Sdk">
  <!-- P11 casting tests (CN-04 streaming server first). Decoding goes through the FFmpeg plugin, so they need the
       FFmpeg libraries and the generated test media; they are skipped, not failed, without them. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <CopyNativeLibraries>true</CopyNativeLibraries>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioTastic.Casting\AudioTastic.Casting.csproj" />
    <ProjectReference Include="..\..\plugins\AudioTastic.Input.Ffmpeg\AudioTastic.Input.Ffmpeg.csproj" />
    <ProjectReference Include="..\AudioTastic.TestSupport\AudioTastic.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
