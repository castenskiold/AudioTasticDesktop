  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioTastic.App\AudioTastic.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
