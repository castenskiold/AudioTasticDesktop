<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for app-level logic that does not need a running UI: skins (UI-03), window snapping (UI-01),
       time/indicator formatting (CO-06, UI-06), key bindings. -->
  <PropertyGroup Condition="'$(IsWindowsBuild)' == 'true'">
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsSupportedVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless" /> <!-- TL-04: controls and automation peers without a window system -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioTastic.App\AudioTastic.App.csproj" />
    <ProjectReference Include="../AudioTastic.TestSupport/AudioTastic.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
