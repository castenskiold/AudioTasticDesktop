<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>AudioTastic</Company>
    <Product>AudioTastic Desktop</Product>
    <Authors>Anders</Authors>
    <Copyright>Copyright © AudioTastic</Copyright>
    <Version>0.10.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- P10 (SI-02, SI-03): the Windows-only parts (Platform.Windows, the app and its tests) target the Windows SDK
         when built on Windows, which is where every Windows RID is built and published (CI too). Elsewhere they stay
         plain net10.0 and the Windows-only code is left out (#if WINDOWS). -->
    <IsWindowsBuild>$([MSBuild]::IsOSPlatform('Windows'))</IsWindowsBuild>
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
    <WindowsSupportedVersion>10.0.17763.0</WindowsSupportedVersion>
  </PropertyGroup>
</Project>
