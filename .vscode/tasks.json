{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/AudioTastic.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/AudioTastic.slnx"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "fetch FFmpeg (win-x64)",
      "command": "python",
      "type": "process",
      "args": ["${workspaceFolder}/native/fetch_ffmpeg.py", "--rid", "win-x64"],
      "problemMatcher": []
    },
    {
      "label": "generate test media",
      "command": "python",
      "type": "process",
      "args": ["${workspaceFolder}/scripts/generate_test_media.py"],
      "problemMatcher": []
    }
  ]
}
