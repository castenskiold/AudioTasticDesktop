<Project Sdk="Microsoft.NET.Sdk">
  <!-- FM-08: MIDI input plugin. MeltySynth (MIT) renders .mid files through a SoundFont; GeneralUser GS is downloaded on
       request from AudioTastic's GitHub release (not bundled: SignPath allows only open-source components, 19 Nov 2026). -->
  <PropertyGroup>
    <IsAudioTasticPlugin>true</IsAudioTasticPlugin>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MeltySynth" />
    <!-- Avalonia is shared with the player (settings page): compile against it, never ship it. -->
    <PackageReference Include="Avalonia" ExcludeAssets="runtime;build;buildTransitive" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioTastic.Sdk\AudioTastic.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AudioTastic.Input.Midi.Tests" />
  </ItemGroup>
</Project>
