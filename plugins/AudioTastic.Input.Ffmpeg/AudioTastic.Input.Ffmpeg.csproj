<Project Sdk="Microsoft.NET.Sdk">
  <!-- FM-01: FFmpeg input plugin (default decoder). References only the SDK, like any third-party plugin. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAudioTasticPlugin>true</IsAudioTasticPlugin>
    <!-- A plugin folder must contain its own dependencies (FFmpeg.AutoGen). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioTastic.Sdk\AudioTastic.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AudioTastic.Input.Ffmpeg.Tests" />
  </ItemGroup>
</Project>
