<Project>
  <!--
    Native libraries produced by the native/ scripts (FFmpeg, miniaudio, SoundTouch, ...) are copied into
    projects that set <CopyNativeLibraries>true</CopyNativeLibraries> (the app and tests that need real audio).
    Publishing for one runtime identifier copies that RID's libraries next to the executable;
    a plain build (F5, dotnet test) copies every RID into runtimes/<rid>/native.
    AudioTastic.Sdk.Interop.NativeLibraries probes both places at run time.
  -->
  <ItemGroup Condition="'$(CopyNativeLibraries)' == 'true' And '$(RuntimeIdentifier)' != '' And Exists('$(RepoRoot)native\out\$(RuntimeIdentifier)\native')">
    <None Include="$(RepoRoot)native\out\$(RuntimeIdentifier)\native\*" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!--
    PG-01 built-in plugins.
    A plugin project sets <IsAudioTasticPlugin>true</IsAudioTasticPlugin>: its plugin.json is copied to the output and,
    after each build, the output (minus the SDK assemblies the host shares) is staged in
    artifacts/plugins/<Configuration>/<project>/.
    The app lists plugins as <BuiltInPlugin Include="...csproj" />: they are built first (not referenced) and their
    staged folders are copied to plugins/<project>/ next to the executable, on build and on publish.
  -->
  <PropertyGroup>
    <PluginStagingRoot>$(RepoRoot)artifacts\plugins\$(Configuration)\</PluginStagingRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsAudioTasticPlugin)' == 'true'">
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="StageAudioTasticPlugin" AfterTargets="Build" Condition="'$(IsAudioTasticPlugin)' == 'true'">
    <ItemGroup>
      <_PluginOutput Include="$(OutDir)**\*"
                     Exclude="$(OutDir)AudioTastic.Sdk.*;$(OutDir)Microsoft.Extensions.Logging.Abstractions.*;$(OutDir)Microsoft.Extensions.DependencyInjection.Abstractions.*;$(OutDir)runtimes\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginOutput)" DestinationFiles="@(_PluginOutput->'$(PluginStagingRoot)$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- PG-04: with <PackAtPlugin>true</PackAtPlugin> (the samples) the staged folder is also zipped as an installable package. -->
  <Target Name="PackAudioTasticPlugin" AfterTargets="StageAudioTasticPlugin" Condition="'$(IsAudioTasticPlugin)' == 'true' And '$(PackAtPlugin)' == 'true'">
    <MakeDir Directories="$(RepoRoot)artifacts\atplugins\$(Configuration)" />
    <ZipDirectory SourceDirectory="$(PluginStagingRoot)$(MSBuildProjectName)" DestinationFile="$(RepoRoot)artifacts\atplugins\$(Configuration)\$(MSBuildProjectName).atplugin" Overwrite="true" />
  </Target>

  <ItemGroup Condition="'@(BuiltInPlugin)' != ''">
    <ProjectReference Include="@(BuiltInPlugin)" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <Target Name="_CollectBuiltInPluginFiles">
    <ItemGroup>
      <_BuiltInPluginFile Include="$(PluginStagingRoot)%(BuiltInPlugin.Filename)\**\*">
        <PluginName>%(BuiltInPlugin.Filename)</PluginName>
      </_BuiltInPluginFile>
    </ItemGroup>
  </Target>
  <Target Name="CopyBuiltInPlugins" AfterTargets="Build" DependsOnTargets="_CollectBuiltInPluginFiles" Condition="'@(BuiltInPlugin)' != ''">
    <Copy SourceFiles="@(_BuiltInPluginFile)" DestinationFiles="@(_BuiltInPluginFile->'$(OutDir)plugins\%(PluginName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBuiltInPlugins" AfterTargets="Publish" DependsOnTargets="_CollectBuiltInPluginFiles" Condition="'@(BuiltInPlugin)' != ''">
    <Copy SourceFiles="@(_BuiltInPluginFile)" DestinationFiles="@(_BuiltInPluginFile->'$(PublishDir)plugins\%(PluginName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup Condition="'$(CopyNativeLibraries)' == 'true' And '$(RuntimeIdentifier)' == '' And Exists('$(RepoRoot)native\out')">
    <None Include="$(RepoRoot)native\out\**\native\*" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
